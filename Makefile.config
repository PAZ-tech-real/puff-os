# Raspberry Pi 5 OS - Build Configuration
# Cross-compilation settings for ARM64 architecture

# Toolchain
CROSS_COMPILE ?= aarch64-linux-gnu-
CC := $(CROSS_COMPILE)gcc
LD := $(CROSS_COMPILE)ld
AS := $(CROSS_COMPILE)as
OBJCOPY := $(CROSS_COMPILE)objcopy
OBJDUMP := $(CROSS_COMPILE)objdump

# Compiler flags
CFLAGS := -Wall -Wextra -Werror
CFLAGS += -O2 -march=armv8-a
CFLAGS += -fno-builtin -nostdinc
CFLAGS += -Iinclude

# Assembler flags
ASFLAGS := -march=armv8-a

# Linker flags
LDFLAGS := -nostdlib -Wl,--build-id=none

# Output
BUILD_DIR := build
OUTPUT := $(BUILD_DIR)/kernel.elf
OUTPUT_IMG := $(BUILD_DIR)/kernel.img

# Platform specific
PLATFORM := rpi5
ARCH := arm64

# Features
ENABLE_UART := 1
ENABLE_INTERRUPTS := 1
ENABLE_SCHEDULER := 1
